# Copy to .env.local and fill in. See CLAUDE.md for details.

# Gemini — used only by the extraction layer (bills PDF vision, policy text)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Solana devnet keypair secret, base58-encoded (server-side signing, no wallet UI)
SOLANA_SECRET_KEY=

# Upstash Redis — production persistence on Vercel (entire store under one key)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# "file" locally (data/store.json), "redis" on Vercel
STORAGE_BACKEND=file
