# Google Gemini API key — needed only for live PDF/DOCX re-extraction; seeded data works without it
GEMINI_API_KEY=
# Gemini model name (default gemini-2.5-flash; verify the model name on the day)
GEMINI_MODEL=
# Base58-encoded Solana devnet keypair secret — needed only for the on-chain anchor feature
SOLANA_SECRET_KEY=
# Upstash Redis REST URL — production (Vercel) persistence only, not used locally
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token — production (Vercel) persistence only, not used locally
UPSTASH_REDIS_REST_TOKEN=
# "file" locally and in Docker (compose forces this), "redis" on Vercel
STORAGE_BACKEND=file
