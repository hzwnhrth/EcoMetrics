# Copy to .env.local and fill in. See CLAUDE.md for details.

# Gemini — used only by the extraction layer (bills PDF vision, policy text)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Solana devnet keypair secret, base58-encoded (server-side signing, no wallet UI)
SOLANA_SECRET_KEY=

# Upstash Redis — production persistence on Vercel (entire store under one key)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# "file" locally (data/store.json), "redis" on Vercel
STORAGE_BACKEND=file

# Session cookie HMAC secret (any long random string; falls back to a demo value)
AUTH_SECRET=

# Reminder emails — injected by the Vercel Marketplace "resend" integration
# (npx vercel integration add resend). Without it, sends report "not configured".
RESEND_API_KEY=
# Sender identity; resend.dev sandbox works out of the box for demos
EMAIL_FROM="EcoMetrics <onboarding@resend.dev>"

# Protects the /api/reminders cron endpoint on Vercel (optional locally)
CRON_SECRET=

# Absolute URL used inside reminder emails (defaults to the Vercel prod URL)
APP_URL=
